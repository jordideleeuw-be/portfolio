  /* =========================================================
     🛠️ 2. JOUW VARIABELE CONTROLS (GRID & FONTS)
     ========================================================= */
  :root {
    --font-base: 'Gibson', system-ui, -apple-system, sans-serif;
    --font-serif: 'EmberCrown', 'Times New Roman', serif;

    --grid-cols: 12;
    --grid-gutter: 1vw;
    --grid-margin: 1vw;
    --grid-color: rgba(0, 0, 0, 0.0);
    --grid-status: grid;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden !important;
    margin: 0;
    padding: 0;
    font-family: var(--font-base);
  }

  /* =========================================================
     🔥 THE FIX: TRUE FULL-BLEED GRID (NO 1600PX LOCK)
     ---------------------------------------------------------
     Removing max-width + margin:0 auto is the entire fix.
     Without a cap, this container's inline-size == 100vw at
     every viewport width, which means every `cqi` value used
     in Hero.astro keeps scaling linearly forever instead of
     freezing once you cross 1600px. Because .hero-grid uses
     the exact same --grid-gutter / --grid-margin variables,
     the two grids stay mathematically identical at all sizes.
     ========================================================= */
  .grid-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 100vh;
    z-index: 9999;
    pointer-events: none;
    display: var(--grid-status);
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    padding: 0 var(--grid-margin);
    box-sizing: border-box;
  }

  .grid-overlay .col {
    width: 100%;
    height: 100%;
    background-color: var(--grid-color);
  }

  /* =========================================================
     ⚡ 4. 9/3 SPLIT LAYOUT SYSTEEM — FROM SCRATCH, ANIMATIE-VEILIG
     ---------------------------------------------------------
     Kern van de herbouw: .left-pane en .right-pane VERANDEREN
     NOOIT MEER van grid-column — die blijven permanent vast op
     kolom 1-9 en 10-12. In plaats daarvan verandert alleen de
     KOLOMBREEDTE zelf op de wrapper (grid-template-columns),
     door kolom 10-12 naar 0fr te laten krimpen bij het sluiten.
     grid-template-columns IS een property die moderne browsers
     vloeiend kunnen interpoleren zolang het aantal tracks gelijk
     blijft (hier steeds 12) — vandaar dat dit wél soepel animeert,
     in tegenstelling tot het wisselen van grid-column zelf.
     ========================================================= */
  .split-layout-wrapper {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), 1fr);
    transition: grid-template-columns 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    column-gap: var(--grid-gutter);
    padding: 0 var(--grid-margin);
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    position: relative;
    font-family: var(--font-base);
  }

  /* Info dicht: kolom 10-12 krijgen 0fr (0 breedte), kolom 1-9
     nemen automatisch de vrijgekomen ruimte over — vloeiend. */
  .split-layout-wrapper.info-closed {
    grid-template-columns: repeat(9, 1fr) repeat(3, 0fr);
  }

  /* Permanente zwarte marge-strook aan de rechterkant, ALTIJD
     zichtbaar ongeacht open/dicht — losstaand van de grid-items
     zelf, dus onafhankelijk van de animatie. */
  .split-layout-wrapper::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: var(--grid-margin);
    height: 100%;
    background-color: #ffffff;
    z-index: 5;
    pointer-events: none;
  }

  .left-pane {
    grid-column: 1 / span 9;
    min-width: 0;
    /* Altijd dezelfde top/bottom padding als de rest van het grid,
       ongeacht wat hier binnenin staat (1 foto, of straks een grid
       van meerdere afbeeldingen). Kolombreedte blijft hierdoor
       exact 9 kolommen — nooit vervormd om in 100vh te passen. */
    padding: var(--grid-margin) 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .right-pane {
    grid-column: 10 / span 3;
    min-width: 0;
    /* background-color: #20fa0328; */
    color: #000000;
    /* border-left: 0.1cqi solid rgba(0, 0, 0, 1); */
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }

  .toggle-btn {
    /* Vast op dezelfde plek t.o.v. .split-layout-wrapper. Geen
       achtergrond, geen border, geen hover, geen tekst — alleen
       het pijltje. Open: los tegen de rand van kolom 12, groter.
       Dicht: even breed als de vaste marge-strook en daarbinnen
       gecentreerd, kleiner. Geen transities — instant wisselen. */
    position: absolute;
    top: 6vh;
    right: 0;
    z-index: 100;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .split-layout-wrapper.info-closed .toggle-btn {
    width: var(--grid-margin);
    display: flex;
    justify-content: center;
  }

  .arrow-icon {
    display: block;
    width: 3.2vw;
    min-width: 44px;
    height: auto;
    /* arrow.svg has a hardcoded white fill (built for the old dark panel);
       brightness(0) forces it black to show up against the white panel. */
    filter: brightness(0);
  }

  .arrow-flipped {
    transform: rotate(180deg);
  }

  .split-layout-wrapper.info-closed .arrow-icon {
    width: 2vw;
    min-width: 28px;
  }

  .pane-content {
    padding: 6vh var(--grid-gutter);
    display: flex;
    flex-direction: column;
    gap: 4vh;
    width: 100%;
    height: 100%;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .right-pane.closed .pane-content { opacity: 0; pointer-events: none; }

  .info-block h3 {
    font-family: var(--font-base);
    font-weight: 400;
    font-size: 3.5cqi;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #555555;
    margin-bottom: 1vh;
  }

  .info-block h2 {
    font-family: var(--font-base);
    font-weight: 400;
    font-size: 8cqi;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .info-block p {
    font-family: var(--font-base);
    font-size: 4.5cqi;
    line-height: 1.6;
    color: #333333;
    text-transform: none;
    font-weight: 400;
  }

  .tools-list { display: flex; flex-wrap: wrap; gap: 0.8vw; align-items: center; }

  /* Jouw SVG's staan al op hetzelfde vierkante artboard — gewoon
     direct tonen, geen wrapper, geen achtergrond, geen padding. */
  .tool-icon {
    width: 5.5cqi;
    height: 5.5cqi;
    min-width: 44px;
    min-height: 44px;
    display: block;
    /* Tool SVGs have a hardcoded white fill (built for the old dark panel);
       brightness(0) forces them black to show up against the white panel. */
    filter: brightness(0);
  }

  /* Onderaan-blok: "bezoek de site" — wordt met margin-top:auto
     naar de onderkant van de info-lade geduwd, net als in het
     referentie-ontwerp. Rendert alleen als liveUrl is meegegeven. */
  .visit-block {
    margin-top: auto;
  }

  .visit-button {
    display: block;
    width: 100%;
    text-align: center;
    background-color: #000000;
    color: #ffffff;
    font-family: var(--font-base);
    font-weight: 800;
    font-size: 3.5cqi;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 1.4vh 0;
    transition: background-color 0.2s ease;
  }

  .visit-button:hover {
    background-color: #333333;
  }
</style>