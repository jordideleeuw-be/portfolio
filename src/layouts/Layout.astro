<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio</title>
  </head>
  <body>
    <!-- DE GRID OVERLAY -->
    <div class="grid-overlay">
      <div class="col"></div><div class="col"></div><div class="col"></div><div class="col"></div>
      <div class="col"></div><div class="col"></div><div class="col"></div><div class="col"></div>
      <div class="col"></div><div class="col"></div><div class="col"></div><div class="col"></div>
    </div>

    <!-- HIER KOMT AL JOUW PAGINA CONTENT IN -->
    <slot />
  </body>
</html>

<style is:global>
  /* =========================================================
     ✍️ 1. CUSTOM FONTS INLADEN (GIBSON SUPER-FAMILY & EMBER CROWN)
     ========================================================= */

  @font-face {
    font-family: 'EmberCrown';
    src: url('/fonts/EmberCrown.otf') format('opentype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  /* Only 4 weights declared — the exact ones actually used anywhere on the
     site (400/600/900 directly, 700 as a spare real weight you own; 800
     has no declaration of its own, so the browser matches it to the
     nearest declared weight, 900). No italics at all — nothing on the
     site ever sets font-style: italic, so none were kept.
     Regular/SemiBold/Bold are your real, authentic files (Gibson.ttf,
     Gibson-SemiBold.ttf, Gibson-Bold.ttf) — Heavy is still the Fontspring
     demo file (kept deliberately; titles aren't causing visible issues). */
  @font-face {
    font-family: 'Gibson';
    src: url('/fonts/Gibson.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gibson';
    src: url('/fonts/Gibson-SemiBold.ttf') format('truetype');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gibson';
    src: url('/fonts/Gibson-Bold.ttf') format('truetype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gibson';
    src: url('/fonts/Fontspring-DEMO-gibson-heavy.otf') format('opentype');
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }

  /* =========================================================
     🛠️ 2. JOUW VARIABELE CONTROLS (GRID & FONTS)
     ========================================================= */
  :root {
    --font-base: 'Gibson', system-ui, -apple-system, sans-serif;
    --font-serif: 'EmberCrown', 'Times New Roman', serif;

    --grid-cols: 12;
    --grid-gutter: 1vw;
    --grid-margin: 3cqi;
    --grid-color: rgba(0, 0, 0, 0.01);
    --grid-status: grid;

    /* Manually tweak these two to resize the black border around every
       project image (FinalWork/Magazine/Internship) and the black outline
       on the magazine's disabled nav arrow. Both are cqi (scale with their
       own local container, not the full page) — image borders scale with
       .project-media below, the arrow outline scales with .nav-btn in
       Magazine.astro. The arrow's stroke uses vector-effect:
       non-scaling-stroke (set on the <polygon> in MagazineViewer.jsx), so
       this cqi value now maps to real rendered pixels like a normal border
       — before that fix, the icon's own internal SVG scale-down was
       shrinking the stroke too, which is why it needed an oversized 30cqi
       just to read as a thin line. */
    --image-border-width: 0.1cqi;
    --arrow-outline-width: 3cqi;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden !important;
    margin: 0;
    padding: 0;
    font-family: var(--font-base);
  }

  /* =========================================================
     🔥 THE FIX: TRUE FULL-BLEED GRID (NO 1600PX LOCK)
     ---------------------------------------------------------
     Removing max-width + margin:0 auto is the entire fix.
     Without a cap, this container's inline-size == 100vw at
     every viewport width, which means every `cqi` value used
     in Hero.astro keeps scaling linearly forever instead of
     freezing once you cross 1600px. Because .hero-grid uses
     the exact same --grid-gutter / --grid-margin variables,
     the two grids stay mathematically identical at all sizes.
     ========================================================= */
  .grid-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 100vh;
    z-index: 9999;
    pointer-events: none;
    display: var(--grid-status);
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    padding: 0 var(--grid-margin);
    box-sizing: border-box;
  }

  .grid-overlay .col {
    width: 100%;
    height: 100%;
    background-color: var(--grid-color);
  }

  /* =========================================================
     ⚡ 4. FULL-WIDTH PROJECT BLOCK
     ---------------------------------------------------------
     Replaces the old 9/3 sidebar split: content now spans all 12
     columns. Title + "Read More" button sit below it; clicking
     the button drops open the description/software list inline
     instead of a permanent side panel. The grid-template-rows
     0fr/1fr trick animates the reveal smoothly without needing a
     JS-measured height.
     ========================================================= */
  .project-block {
    width: 100%;
    padding: 0 var(--grid-margin);
    box-sizing: border-box;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    font-family: var(--font-base);
    /* Establishes the cqi context for .tool-icon below (the title/details/
       tools-list area doesn't sit inside .project-media, which is what the
       image borders use, so it needs its own container here). */
    container-type: inline-size;
  }

  .project-media {
    width: 100%;
    padding: var(--grid-margin) 0;
    display: flex;
    justify-content: center;
    align-items: center;
    /* Establishes the cqi context for --image-border-width, shared by every
       project's images (FinalWork/Magazine/Internship all render into this
       same wrapper via SplitLayout's leftContent slot). */
    container-type: inline-size;
  }

  .project-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--grid-gutter);
    padding-bottom: 2vh;
  }

  .project-title {
    font-family: var(--font-base);
    font-weight: 800;
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    text-transform: uppercase;
    color: #000000;
    margin: 0;
  }

  .read-more-btn {
    flex-shrink: 0;
    background: none;
    border: 2px solid #000000;
    color: #000000;
    font-family: var(--font-base);
    font-weight: 600;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.7rem 0;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    /* Grid-locked width — exactly one column plus one gutter (against
       .project-block's cqi context), not an arbitrary rem value. Fixed
       (not content-based) so the button doesn't resize between its two
       states — "Read More" and "Read Less" render at slightly different
       natural widths otherwise — with the text centered inside either way.
       clamp()'d for the same reason as the hero buttons/nav arrows: cqi
       tied to a near-full-page-width container scales forever without one. */
    width: clamp(6rem, calc((100cqi - 11 * var(--grid-gutter)) / 12 + var(--grid-gutter)), 11rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .read-more-btn:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .project-details {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s ease;
  }

  .project-details.open {
    grid-template-rows: 1fr;
  }

  .project-details-inner {
    overflow: hidden;
    min-height: 0;
  }

  .project-details-content {
    padding-top: 3vh;
    display: flex;
    flex-direction: column;
    gap: 3vh;
  }

  .info-block h3 {
    font-family: var(--font-base);
    font-weight: 400;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #555555;
    margin-bottom: 0.8vh;
  }

  .info-block p {
    font-family: var(--font-base);
    font-size: 1.3cqi;
    line-height: 1.5;
    color: #333333;
    text-transform: none;
    font-weight: 400;
  }

  /* Space between separate paragraph blocks (description split on line
     breaks in SplitLayout.jsx) — not needed before the first one. */
  .info-block p + p {
    margin-top: 1em;
  }

  /* Second, SMALLER ceiling for .project-title/.info-block p, only past a
     genuinely wide monitor — the rules above are untouched below this
     breakpoint, so a MacBook-class display keeps exactly the size that
     already looks right there. cqi (against .project-block, same
     container the tool icons use) rather than a flat override, so it
     still eases in smoothly above this width instead of jumping to one
     fixed number and going flat again.
     1800px comfortably clears a maximized 16" MacBook Pro (1728px logical)
     — raise this if your MacBook is wider than that and this ever kicks in
     on it too, or lower it if your external monitor still looks big. */
  @media (min-width: 1800px) {
    .project-title {
      font-size: clamp(1.75rem, 2.2cqi, 2.5rem);
    }

    .info-block p {
      font-size: clamp(0.9rem, 1.1cqi, 1.1rem);
    }
  }

  /* About + Software Used side by side, on the same 12-column grid used
     site-wide. Software Used is capped at 5 columns (not left to grow with
     however much room is available) so its icons wrap onto a new row
     inside that width instead of spreading out across a wide single row. */
  .info-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    align-items: flex-start;
    width: 100%;
  }

  .about-block {
    grid-column: span 6;
  }

  /* No Software Used block (e.g. Internship before tools existed) — About
     takes the full width instead of stopping at 6 columns for no reason. */
  .info-row > .about-block:only-child {
    grid-column: span 12;
  }

  /* Starts at column 8 (not auto-placed right after About's 6 columns) so
     column 7 sits empty as a gap between the two blocks. */
  .tools-block {
    grid-column: 8 / span 5;
  }

  /* Standard fixed gap (cqi, not px/vw), and flex-wrap: nowrap — icons must
     always stay on one row (see .tool-icon below for how that's actually
     guaranteed, not just requested). */
  .tools-list {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(6px, 1cqi, 16px);
    align-items: center;
  }

  /* Jouw SVG's staan al op hetzelfde vierkante artboard — gewoon
     direct tonen, geen wrapper, geen achtergrond, geen padding. */
  /* clamp(36-50px) is the PREFERRED size (cqi against .project-block, same
     as everywhere else) — but flex-shrink (min-width:0 overrides the
     browser's default "never shrink an image below its intrinsic size")
     lets every icon shrink below that whenever the row is too narrow to
     fit all of them at once, instead of wrapping. That's what actually
     guarantees one row at every viewport width — a fixed/capped size alone
     can't, since the row's own width and the icon's capped size don't
     scale at the same rate, so there's always some viewport range where a
     fixed size overflows (this is why it broke on one screen but not
     another: not "wider is worse", just a mismatch between the two). */
  .tool-icon {
    flex: 0 1 clamp(36px, 4cqi, 50px);
    min-width: 0;
    height: auto;
    aspect-ratio: 1;
    display: block;
  }

  .visit-block {
    margin-top: 1.5rem;
  }

  .visit-button {
    display: inline-block;
    text-align: center;
    background-color: #000000;
    border: 2px solid #000000;
    color: #ffffff;
    font-family: var(--font-base);
    font-weight: 600;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 0.9rem 2rem;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .visit-button:hover {
    background-color: #333333;
  }
</style>