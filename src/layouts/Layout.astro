---
import './Layout.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <title>Jordi De Leeuw</title>
  </head>
  <body>
    <!-- DE GRID OVERLAY -->
    <div class="grid-overlay">
      <div class="col"></div><div class="col"></div><div class="col"></div><div class="col"></div>
      <div class="col"></div><div class="col"></div><div class="col"></div><div class="col"></div>
      <div class="col"></div><div class="col"></div><div class="col"></div><div class="col"></div>
    </div>

    <!-- HIER KOMT AL JOUW PAGINA CONTENT IN -->
    <slot />

    <script>
      // The elastic overscroll bounce (mobile Safari) fills with whatever
      // background-color <html> currently has — there's no way to give the
      // top and bottom edges different colors with CSS alone, since it's a
      // single property for the whole page. Toggling it based on scroll
      // position instead: white while nearer the top (matches Hero),
      // black once you're past the midpoint (matches the footer).
      function updateOverscrollColor() {
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const nearBottom = maxScroll > 0 && window.scrollY > maxScroll / 2;
        const color = nearBottom ? '#000' : '#fff';
        // Safari's rubber-band bounce paints from <body>'s background, not
        // <html>'s — setting only documentElement (as before) left <body>
        // pinned to its CSS white forever, so the bottom bounce never
        // actually turned black on a real device. Both need the inline
        // style since that's what needs to win over the stylesheet rule.
        document.documentElement.style.backgroundColor = color;
        document.body.style.backgroundColor = color;
      }

      updateOverscrollColor();
      window.addEventListener('scroll', updateOverscrollColor, { passive: true });
      window.addEventListener('resize', updateOverscrollColor);
    </script>
  </body>
</html>
