---
import { getImage } from 'astro:assets';
import SplitLayout from './SplitLayout.jsx';
import jidliInclusions from '../assets/images/JIDLI_INCLUSIONS.png';
import jidliInclusionsMobile from '../assets/images/JIDLI_INCLUSIONS_MOBILE_tall.png';
import showreelPosterSrc from '../assets/images/showreel-poster.jpg';
import jidliEventSrc from '../assets/images/Jidli_event.png';
import jidli4Src from '../assets/images/JILDI_4_FINAL.png';
import styles from './FinalWork.module.css';

// A plain URL (not the <Image> component) since it's used as a native
// <video poster> attribute, not rendered as its own <img>.
const showreelPoster = await getImage({ src: showreelPosterSrc, width: 800, format: 'webp' });

// Two-stage load for the showcase image: a solid, genuinely sharp 2600px
// version loads first (fast, looks good on virtually any screen), then a
// second request for the full-resolution responsive version (up to 7600px,
// for large/HiDPI displays) only starts once that first one finishes —
// sequential, not parallel, so the big request never competes with the
// first for bandwidth. No blur/scale tricks — both stages are genuinely
// sharp images, just different sizes.
const showcaseStage1 = await getImage({ src: jidliInclusions, width: 2600, format: 'webp' });

const showcaseFullWidths = [2000, 2600, 3200, 4000, 5200, 6400, 7600];
const showcaseFullVariants = await Promise.all(
  showcaseFullWidths.map((width) => getImage({ src: jidliInclusions, width, format: 'webp' }))
);
const showcaseFullSrcset = showcaseFullVariants.map((v) => `${v.src} ${v.attributes.width}w`).join(', ');

// Same two-stage pattern, mobile-only — a separate 3:4 portrait source
// (not just a resize of the desktop 4:3-ish one), shown tall and full
// width instead of the desktop treatment. Smaller width tiers since it's
// only ever displayed at phone width, not full-bleed on a desktop monitor.
const showcaseMobileStage1 = await getImage({ src: jidliInclusionsMobile, width: 1200, format: 'webp' });
const showcaseMobileFullWidths = [900, 1200, 1600, 2000, 2400, 2900];
const showcaseMobileFullVariants = await Promise.all(
  showcaseMobileFullWidths.map((width) => getImage({ src: jidliInclusionsMobile, width, format: 'webp' }))
);
const showcaseMobileFullSrcset = showcaseMobileFullVariants.map((v) => `${v.src} ${v.attributes.width}w`).join(', ');

// Same two-stage pattern as Internship's grid tiles (half resolution
// first, then native), not the showcase image's big multi-tier srcset —
// this is a small grid tile, not full-bleed hero content.
const eventFull = await getImage({ src: jidliEventSrc, format: 'webp' });
const eventStage1 = await getImage({ src: jidliEventSrc, width: Math.round(eventFull.attributes.width / 2), format: 'webp' });

const jidli4 = await getImage({ src: jidli4Src, width: 1600, format: 'webp' });
---

<section class={styles.screen}>
  <SplitLayout
    client:load
    title="JIDLI — Hybrid Album"
    description={`Voor mijn eindwerk binnen de opleiding Multimedia & Creatieve Technologie onderzocht ik hoe de integratie van een interactief, fysiek object de K-pop albumervaring gelaagder en intenser kan maken. Om de volledige creatieve controle te hebben, ontwikkelde ik 'JIDLI': een fictieve K-pop groep compleet met een eigen visuele identiteit, karakters en songteksten voor het debuutalbum Unidentified Frivolous Object. Door deze wereld vanaf nul op te bouwen, kon ik de esthetiek en functionaliteit perfect afstemmen op mijn onderzoeksvraag.
De kern van het project is de brug tussen fysiek verzamelobject en digitale interface. Ik ontwierp een op maat gemaakte behuizing waarin het klassieke papieren fotoboek is getransformeerd naar een interactieve applicatie op een ingebouwde iPad. De fysieke fotokaarten die ik ontwierp, zijn uitgerust met NFC-tags. Zodra deze in het verborgen scan-element van de behuizing worden geplaatst, ontgrendelen ze unieke, digitale verhalen op het scherm.
Ieder groepslid heeft zo een eigen verhaallijn en muzieknummer gekregen. Door deze tastbare interactie bouwt de gebruiker een veel directere connectie op met de artiesten. Van de fysieke behuizing en de grafische extra's tot de digitale UX/UI-flow: alles is volledig zelf ontworpen. Het resultaat is een modern verzamelobject dat traditioneel grafisch design naadloos laat samensmelten met interactieve technologie.`}
    tools={["InDesign", "Illustrator", "Photoshop", "After Effects", "Premiere Pro", "Figma", "Maya", "Google AI", "Suno", "Swift"]}
  >
    {/* ALLES WAT JE HIER TUSSEN ZET, KOMT AUTOMATISCH IN DE 9-KOLOMMEN LINKERKANT! */}
    <div slot="leftContent" class={styles['my-visuals']}>
      <div class={styles['showcase-desktop']}>
        <div class={styles['showcase-wrapper']}>
          <img
            src={showcaseStage1.src}
            alt="JIDLI — Hybrid Album showcase"
            class={styles['showcase-image']}
            data-full-srcset={showcaseFullSrcset}
            width={showcaseStage1.attributes.width}
            height={showcaseStage1.attributes.height}
            loading="lazy"
          />
        </div>
      </div>
      <div class={styles['showcase-mobile']}>
        <div class={styles['showcase-wrapper']}>
          <img
            src={showcaseMobileStage1.src}
            alt="JIDLI — Hybrid Album showcase"
            class={styles['showcase-image']}
            data-full-srcset={showcaseMobileFullSrcset}
            width={showcaseMobileStage1.attributes.width}
            height={showcaseMobileStage1.attributes.height}
            loading="lazy"
          />
        </div>
      </div>
      <div class={styles['placeholder-row']}>
        {/* Native <video poster> + preload="none": the browser shows the
            poster on its own, and never requests the 13MB video file until
            .play() is called on click. No custom DOM creation or manual
            sizing — that's what was causing the black-frame rendering bug. */}
        <div class={styles['video-tile']} id="showreel-tile">
          <video id="showreel-video" class={styles['video-poster']} poster={showreelPoster.src} preload="none" playsinline>
            <source src="/videos/jidli-showreel.mp4" type="video/mp4" />
          </video>
          <button class={styles['video-play-btn']} id="showreel-play-btn" aria-label="Play showreel" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5v14l11-7z" fill="currentColor" />
            </svg>
          </button>
        </div>
        <div class={styles['placeholder-box']}>
          <img
            src={eventStage1.src}
            width={eventStage1.attributes.width}
            height={eventStage1.attributes.height}
            alt="JIDLI event"
            class={styles['tile-image']}
            id="event-stage1"
            data-full-src={eventFull.src}
            loading="lazy"
          />
        </div>
        <div class={styles['placeholder-box']}>
          <img
            src={jidli4.src}
            width={jidli4.attributes.width}
            height={jidli4.attributes.height}
            alt="JIDLI mockup"
            class={styles['tile-image']}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </SplitLayout>
</section>

<script define:vars={{
  showcaseImageClass: styles['showcase-image'],
  showcaseImageFullClass: styles['showcase-image--full'],
  loadedClass: styles.loaded,
}}>
  // Sequential two-stage upgrade: only start fetching each one's full-res
  // srcset once its own fast stage-1 image has actually finished loading,
  // so the two never compete for bandwidth. Loops over every showcase
  // stage-1 on the page (desktop's 4:3-ish version and the mobile 3:4
  // one) — same upgrade logic, each with its own srcset via data-full-srcset.
  const stage1Images = document.querySelectorAll(`.${showcaseImageClass}[data-full-srcset]`);

  stage1Images.forEach((stage1) => {
    if (!(stage1 instanceof HTMLImageElement)) return;
    const showcaseWrapper = stage1.parentElement;
    const fullSrcset = stage1.dataset.fullSrcset;
    if (!showcaseWrapper || !fullSrcset) return;

    function upgradeShowcaseToFullRes() {
      const stage2 = document.createElement('img');
      stage2.alt = '';
      stage2.setAttribute('aria-hidden', 'true');
      // CSS Modules hashes class names into the imported `styles` object
      // itself, so setting className with those hashed strings is enough
      // to match the module's rules — no data-astro-cid copying needed
      // for elements created here via JS.
      stage2.className = `${showcaseImageClass} ${showcaseImageFullClass}`;
      stage2.sizes = '(max-width: 900px) 100vw, 95vw';
      stage2.srcset = fullSrcset;
      stage2.addEventListener('load', () => stage2.classList.add(loadedClass), { once: true });
      showcaseWrapper.appendChild(stage2);
    }

    if (stage1.complete) {
      upgradeShowcaseToFullRes();
    } else {
      stage1.addEventListener('load', upgradeShowcaseToFullRes, { once: true });
    }
  });
</script>

<script define:vars={{
  tileImageClass: styles['tile-image'],
  tileImageFullClass: styles['tile-image--full'],
  loadedClass: styles.loaded,
}}>
  // Same two-stage upgrade as the showcase image above, just for the
  // JIDLI event tile — half-resolution stage 1 already in the static
  // markup, swapped for the full-resolution version once it's loaded.
  const eventStage1 = document.getElementById('event-stage1');

  function upgradeEventToFullRes() {
    const wrapper = eventStage1.parentElement;
    if (!wrapper) return;
    const stage2 = document.createElement('img');
    stage2.src = eventStage1.dataset.fullSrc;
    stage2.alt = '';
    stage2.setAttribute('aria-hidden', 'true');
    stage2.className = `${tileImageClass} ${tileImageFullClass}`;
    stage2.addEventListener('load', () => stage2.classList.add(loadedClass), { once: true });
    wrapper.appendChild(stage2);
  }

  if (eventStage1 instanceof HTMLImageElement) {
    if (eventStage1.complete) {
      upgradeEventToFullRes();
    } else {
      eventStage1.addEventListener('load', upgradeEventToFullRes, { once: true });
    }
  }
</script>

<script>
  const video = document.getElementById('showreel-video');
  const playBtn = document.getElementById('showreel-play-btn');

  playBtn?.addEventListener('click', () => {
    if (!(video instanceof HTMLVideoElement)) return;
    video.controls = true;
    playBtn.style.display = 'none';
    video.play();
  });
</script>
