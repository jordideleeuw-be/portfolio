---
import { Image, getImage } from 'astro:assets';
import SplitLayout from './SplitLayout.jsx';
import jidliInclusions from '../assets/images/JIDLI_INCLUSIONS.jpg';
import showreelPosterSrc from '../assets/images/showreel-poster.jpg';

// A plain URL (not the <Image> component) since it's used as a native
// <video poster> attribute, not rendered as its own <img>.
const showreelPoster = await getImage({ src: showreelPosterSrc, width: 800, format: 'webp' });
---

<section class="screen final-work">
  <SplitLayout 
    client:load
    title="JIDLI — Hybrid Album"
    description="An exploratory project merging physical K-pop packaging with digital interfaces. The showcase includes a custom interactive iPad application, an NFC card scanner slot, and a printed editorial magazine."
    tools={["InDesign", "Illustrator", "Photoshop", "Lightroom", "After Effects", "Premiere Pro", "Figma", "Maya", "Google AI", "Suno", "Swift"]}
  >
    {/* ALLES WAT JE HIER TUSSEN ZET, KOMT AUTOMATISCH IN DE 9-KOLOMMEN LINKERKANT! */}
    <div slot="leftContent" class="my-visuals">
      <Image
        src={jidliInclusions}
        alt="JIDLI — Hybrid Album showcase"
        class="showcase-image"
        widths={[400, 800, 1200, 1600, 2000, 2554]}
        sizes="(max-width: 900px) 100vw, 75vw"
        format="webp"
      />
      <div class="placeholder-row">
        {/* Native <video poster> + preload="none": the browser shows the
            poster on its own, and never requests the 13MB video file until
            .play() is called on click. No custom DOM creation or manual
            sizing — that's what was causing the black-frame rendering bug. */}
        <div class="video-tile" id="showreel-tile">
          <video id="showreel-video" class="video-poster" poster={showreelPoster.src} preload="none" playsinline>
            <source src="/videos/jidli-showreel.mp4" type="video/mp4" />
          </video>
          <button class="video-play-btn" id="showreel-play-btn" aria-label="Play showreel" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5v14l11-7z" fill="currentColor" />
            </svg>
          </button>
        </div>
        <div class="placeholder-box"><span class="placeholder-label">Add image</span></div>
        <div class="placeholder-box"><span class="placeholder-label">Add image</span></div>
      </div>
    </div>
  </SplitLayout>
</section>

<script>
  const video = document.getElementById('showreel-video');
  const playBtn = document.getElementById('showreel-play-btn');

  playBtn?.addEventListener('click', () => {
    if (!(video instanceof HTMLVideoElement)) return;
    video.controls = true;
    playBtn.style.display = 'none';
    video.play();
  });
</script>

<style>
  .screen {
    width: 100%;
    min-height: 100vh;
    background-color: #fff;
  }

  .my-visuals {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--grid-margin);
  }

  .showcase-image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Same 4:3 padding-top box as .placeholder-box, but holding the poster
     image (then the video once clicked) instead of a placeholder label. */
  .video-tile {
    width: 100%;
    height: 0;
    padding-top: 75%;
    position: relative;
    background-color: #000000;
    overflow: hidden;
    cursor: pointer;
  }

  .video-poster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.92);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .video-play-btn:hover {
    transform: translate(-50%, -50%) scale(1.08);
    background-color: #ffffff;
  }

  .video-play-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    margin-left: 3px; /* optical centering for the play triangle */
    color: #000000;
  }

  .placeholder-row {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  /* 4:3 ratio via the padding-top percentage hack (not the `aspect-ratio`
     property) — this sits inside SplitLayout's animated info-panel grid,
     and aspect-ratio doesn't reliably recompute across that transition. */
  .placeholder-box {
    width: 100%;
    height: 0;
    padding-top: 75%;
    position: relative;
    background-color: rgba(0, 0, 0, 0.15);
    /* outline instead of border — border would add to the box-sizing
       calculation and throw off the 4:3 ratio from the padding-top hack. */
    outline: 2px dashed rgba(0, 0, 0, 0.4);
    outline-offset: -2px;
  }

  .placeholder-label {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(0, 0, 0, 0.55);
  }
</style>