---
// Internship.astro
import { getImage } from 'astro:assets';
import SplitLayout from './SplitLayout.jsx';

import img01 from '../assets/images/01_instapost.png';
import img02 from '../assets/images/02_schutbladen.png';
import img03 from '../assets/images/03_hanenbos.png';
import img04 from '../assets/images/04_chasingtherainbow.png';
import img05 from '../assets/images/05_etalage.png';
import img06 from '../assets/images/06_moodboards.png';
import img07 from '../assets/images/07_newspaper.png';
import img08 from '../assets/images/08_logoredesign.png';
import img09 from '../assets/images/09_cube.png';
import img10 from '../assets/images/10_webdesign.png';
import jewelryPosterSrc from '../assets/images/jewelry-poster.jpg';
import addPosterSrc from '../assets/images/add-poster.jpg';

// Grid order matches each file's own numeric prefix — 01 is the first tile
// (top-left), reading left-to-right, top-to-bottom across the 3x4 grid.
const galleryImages = [img01, img02, img03, img04, img05, img06, img07, img08, img09, img10];

// Two-stage load, same pattern as FinalWork/Magazine: a fast "half of the
// ideal resolution" version loads first, then swaps to the full — native,
// since these source files aren't large to begin with — resolution once
// that first one finishes. Widths are read off each image's own metadata
// rather than hardcoded, so this doesn't need updating if the source photos
// change size later.
const imageTiles = await Promise.all(
  galleryImages.map(async (src) => {
    const stage1 = await getImage({ src, width: Math.round(src.width / 2), format: 'webp' });
    const full = await getImage({ src, width: src.width, format: 'webp' });
    return {
      type: 'image',
      stage1Src: stage1.src,
      stage1Width: stage1.attributes.width,
      stage1Height: stage1.attributes.height,
      fullSrc: full.src,
    };
  })
);

// Same native <video poster> + preload="none" facade as FinalWork's
// showreel tile — the browser shows the poster on its own and never
// requests the video file until .play() is called on click.
const jewelryPoster = await getImage({ src: jewelryPosterSrc, width: 800, format: 'webp' });
const addPoster = await getImage({ src: addPosterSrc, width: 800, format: 'webp' });

const videoTiles = [
  { type: 'video', poster: jewelryPoster.src, src: '/videos/11_jewelry.mp4', label: 'Jewelry' },
  { type: 'video', poster: addPoster.src, src: '/videos/12_add.mp4', label: 'Add' },
];

// 10 images then 2 videos — tiles 1-10, then 11-12, matching the source
// filenames' own numbering.
const items = [...imageTiles, ...videoTiles];
---
<section class="screen internship">
  <SplitLayout
    client:load
    title="Internship"
    description="Tijdens mijn stage bij WNDR, een compacte creatieve studio in Brussel, draaide ik mee als volwaardig lid van het team en werd ik direct betrokken bij het volledige creatieve proces. In plaats van een afgelijnd takenpakket werkte ik intensief mee aan meer dan tien verschillende klantcases én kreeg ik het vertrouwen om het volledige webdesign van de WNDR portfolio-website op mij te nemen. Mijn werk schakelde continu tussen concept en uitvoering: van brainstorms, moodboards en het uitwerken van logo-voorstellen, tot complexe lay-outs voor uiteenlopende redactionele publicaties en ruimtelijke toepassingen. Daarnaast ontwikkelde ik motion graphics en animaties in After Effects voor diverse commerciële en culturele merken.

Deze hands-on ervaring zorgde voor een enorme groeispurt in mijn technische vaardigheden, waarbij ik vooral mijn workflow in InDesign en mijn inzicht in typografische verhoudingen sterk heb verfijnd. Door de nauwe samenwerking met de oprichters, het bijwonen van klantmeetings en praktijkbezoeken aan de drukkerij, leerde ik hoe ontwerptheorie zich daadwerkelijk vertaalt naar de professionele praktijk. Het resultaat is een brede waaier aan projecten waar ik enorm trots op ben, en een veel zelfverzekerdere visie als veelzijdige maker."
    tools={["InDesign", "Photoshop", "Illustrator", "Premiere Pro", "Figma"]}
    liveUrl="https://wndrstudio.be/"
    liveLabel="ontdek hun portfoliowebsite die ik mee ontwierp"
    liveButtonText="bezoek haar"
  >
    <div slot="leftContent" class="left-content">
      {/* 12 tiles, 3 columns x 4 rows, all 4:3 — 10 photos then 2 videos. */}
      <div class="tile-grid">
        {items.map((item) => (
          item.type === 'image' ? (
            <div class="tile">
              <img
                src={item.stage1Src}
                width={item.stage1Width}
                height={item.stage1Height}
                alt=""
                class="tile-image"
                data-full-src={item.fullSrc}
                loading="lazy"
              />
            </div>
          ) : (
            <div class="tile video-tile">
              <video
                class="tile-video"
                data-autoplay-video
                poster={item.poster}
                preload="none"
                muted
                loop
                playsinline
                aria-label={`${item.label} video`}
              >
                <source src={item.src} type="video/mp4" />
              </video>
              <button class="tile-fullscreen-btn" data-fullscreen-btn aria-label={`View ${item.label} video fullscreen`} type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" fill="currentColor" />
                </svg>
              </button>
            </div>
          )
        ))}
      </div>
    </div>
  </SplitLayout>
</section>

<script>
  // Sequential two-stage upgrade for every tile image on this page: only
  // start fetching the full-res version once that tile's own fast stage-1
  // image has actually finished loading, so requests never compete with
  // each other for bandwidth.
  const stage1Images = document.querySelectorAll('.tile-image[data-full-src]');

  stage1Images.forEach((stage1) => {
    if (!(stage1 instanceof HTMLImageElement)) return;
    const wrapper = stage1.closest('.tile');
    const fullSrc = stage1.dataset.fullSrc;
    if (!wrapper || !fullSrc) return;

    function upgrade() {
      const stage2 = document.createElement('img');
      stage2.src = fullSrc;
      stage2.alt = '';
      stage2.setAttribute('aria-hidden', 'true');
      stage2.className = 'tile-image tile-image--full';
      // Astro's scoped <style> below only tags elements present in the
      // static template — an element created here via JS never gets that
      // attribute, so copy it from stage1 (see the identical fix on
      // FinalWork's showcase image for why this matters).
      for (const attr of stage1.attributes) {
        if (attr.name.startsWith('data-astro-cid')) {
          stage2.setAttribute(attr.name, attr.value);
        }
      }
      stage2.addEventListener('load', () => stage2.classList.add('loaded'), { once: true });
      wrapper.appendChild(stage2);
    }

    if (stage1.complete) {
      upgrade();
    } else {
      stage1.addEventListener('load', upgrade, { once: true });
    }
  });
</script>

<script>
  // Muted autoplay loop, but only once a tile is actually scrolled into
  // view — preload="none" means nothing downloads until .play() is called,
  // so these 18-36MB files don't start fetching on page load, only when a
  // visitor actually scrolls down to them. Paused (not just left alone)
  // once a tile scrolls back out, so it isn't still decoding off-screen.
  const videos = document.querySelectorAll('[data-autoplay-video]');

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target;
        if (!(video instanceof HTMLVideoElement)) continue;
        if (entry.isIntersecting) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      }
    },
    { threshold: 0.25 }
  );

  videos.forEach((video) => observer.observe(video));
</script>

<script>
  // Click-to-fullscreen: the loop itself stays muted/autoplaying, but this
  // opens the same <video> in the browser's native fullscreen view with
  // sound and controls, then reverts back to a silent looping preview on
  // exit. iOS Safari has no generic Fullscreen API for arbitrary elements,
  // only a video-specific one (webkitEnterFullscreen), so that's handled
  // as a separate path.
  document.querySelectorAll('.video-tile').forEach((tile) => {
    const video = tile.querySelector('.tile-video');
    const btn = tile.querySelector('[data-fullscreen-btn]');
    if (!(video instanceof HTMLVideoElement) || !btn) return;

    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      if (typeof video.requestFullscreen === 'function') {
        video.requestFullscreen().catch(() => {});
      } else if (typeof video.webkitEnterFullscreen === 'function') {
        video.muted = false;
        video.controls = true;
        video.webkitEnterFullscreen();
      }
    });

    document.addEventListener('fullscreenchange', () => {
      const isFullscreen = document.fullscreenElement === video;
      video.muted = !isFullscreen;
      video.controls = isFullscreen;
    });
  });
</script>

<style>
  .screen {
    width: 100%;
    min-height: 100vh;
    background-color: #fff;
  }

  .left-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Real 4-column-span slice of the site's 12-column grid (var(--grid-gutter),
     same as .grid-overlay/.hero-grid) instead of an independent repeat(3, 1fr)
     with a flat 1rem gap — that local grid only coincidentally lined up with
     the real grid at some viewport widths and drifted at others. */
  .tile-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: var(--grid-gutter);
  }

  .tile-grid > .tile {
    grid-column: span 4;
  }

  /* 4:3 via the padding-top percentage hack (not the `aspect-ratio`
     property) — this sits inside SplitLayout's animated info-panel grid,
     which aspect-ratio doesn't reliably survive. */
  .tile {
    width: 100%;
    height: 0;
    padding-top: 75%;
    position: relative;
    background-color: rgba(0, 0, 0, 0.15);
    border: var(--image-border-width) solid #000000;
    overflow: hidden;
  }

  /* Source photos are ~1554x1251 (one at 3680x2760), not an exact 4:3 —
     object-fit: cover fills the tile edge-to-edge with a small crop rather
     than letterboxing, which reads better in a dense photo grid like this
     one (unlike the magazine spreads, these tiles don't need to preserve
     the full, uncropped frame). */
  .tile-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Two-stage load: stage 1 renders immediately and stays visible; stage 2
     (injected by the script above once stage 1 finishes) sits on top at
     the same position and fades in once its own full-res file has loaded. */
  .tile-image--full {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tile-image--full.loaded {
    opacity: 1;
  }

  .tile-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Hidden until hovered so it doesn't compete with the autoplay loop
     visually — always shown on touch devices, which have no hover state
     to reveal it with. */
  .tile-fullscreen-btn {
    position: absolute;
    bottom: 0.6rem;
    right: 0.6rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.85);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    z-index: 2;
  }

  .video-tile:hover .tile-fullscreen-btn,
  .tile-fullscreen-btn:focus-visible {
    opacity: 1;
  }

  .tile-fullscreen-btn:hover {
    background-color: #ffffff;
    transform: scale(1.08);
  }

  .tile-fullscreen-btn svg {
    width: 1.1rem;
    height: 1.1rem;
    color: #000000;
  }

  @media (hover: none) {
    .tile-fullscreen-btn {
      opacity: 1;
    }
  }
</style>
