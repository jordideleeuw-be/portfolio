---
import { getImage } from 'astro:assets';
import MagazineViewer from './MagazineViewer.jsx';

import page1 from '../assets/images/page1.jpg';
import page23 from '../assets/images/page2-3.jpg';
import page45 from '../assets/images/page4-5.jpg';
import page67 from '../assets/images/page6-7.jpg';
import page8 from '../assets/images/page8.jpg';

const rawSpreads = [
  { id: 1, src: page1, caption: 'Cover' },
  { id: 2, src: page23, caption: 'Spread 01 — Index & Editorial' },
  { id: 3, src: page45, caption: 'Spread 02 — Visual Essay' },
  { id: 4, src: page67, caption: 'Spread 03 — Typography' },
  { id: 5, src: page8, caption: 'Backcover' },
];

// astro:assets only works inside .astro templates, so the spreads are
// optimized here and handed to the React viewer as plain URLs.
const spreads = await Promise.all(
  rawSpreads.map(async ({ id, src, caption }) => {
    const optimized = await getImage({ src, format: 'webp', width: 1600 });
    return { id, image: optimized.src, caption };
  })
);
---

<section class="screen magazine">
  <div class="content-wrapper">
    <!-- De Viewer laadt hier live in -->
    <MagazineViewer client:load spreads={spreads} />
  </div>
</section>

<style is:global>
  /* GLOBAL STYLES VOOR DE REACT VIEWER (Omdat het in React zit, werkt is:global hier het best) */
  .magazine-container {
    width: 100%;
    max-width: 1200px; /* Bepaalt hoe breed je spread maximaal mag worden op grote schermen */
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .spread-frame {
    width: 100%;
    height: 70vh; /* Pakt maximaal 70% van de schermhoogte zodat je knoppen altijd in beeld blijven */
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.03); /* Heel subtiel achtergrondje voor als een foto laadt */
  }

  .spread-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain; /* CRUCIAAL: Zorgt dat je foto ALTIJD in zijn originele verhouding past! */
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15); /* Subtiele, dure studio-schaduw */
    transition: opacity 0.3s ease-in-out;
  }

  /* Knoppen en tekst styling */
  .magazine-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 600px;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-btn {
    background: none;
    border: 2px solid #000000;
    color: #000000;
    padding: 0.6rem 1.2rem;
    font-family: inherit;
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nav-btn:hover:not(:disabled) {
    background-color: #000000;
    color: #ffffff;
  }

  .nav-btn:disabled {
    border-color: rgba(0, 0, 0, 0.2);
    color: rgba(0, 0, 0, 0.2);
    cursor: not-allowed;
  }

  .spread-counter {
    color: #000000;
  }
  
  .caption-text {
    font-weight: 400;
    opacity: 0.7;
  }
</style>

<style>
  /* De basis sectie */
  .screen {
    width: 100%;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #ff9f43; /* Je achtergrondkleur */
    padding: 2rem;
  }

  .content-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>