---
import { getImage } from 'astro:assets';
import MagazineViewer from './MagazineViewer.jsx';
import SplitLayout from './SplitLayout.jsx';
import styles from './Magazine.module.css';

import magazineCover from '../assets/images/magazine-cover.png';
import magazineSpread1 from '../assets/images/magazine-spread1.png';
import magazineSpread2 from '../assets/images/magazine-spread2.png';
import magazineSpread3 from '../assets/images/magazine-spread3.png';
import magazineBackcover from '../assets/images/magazine-backcover.png';
import magazinePage1 from '../assets/images/page1.png';
import magazinePage2 from '../assets/images/page2.png';
import magazinePage3 from '../assets/images/page3.png';
import magazinePage4 from '../assets/images/page4.png';
import magazinePage5 from '../assets/images/page5.png';
import magazinePage6 from '../assets/images/page6.png';

// Native resolution: cover/backcover (portrait) are 5103x7158; the three
// spreads (landscape) are 10063x7158. Orientation is known statically per
// file, so it doesn't need to be derived from a fetched variant.
const rawSpreads = [
  { id: 1, src: magazineCover, caption: 'Cover', orientation: 'portrait' },
  { id: 2, src: magazineSpread1, caption: 'Spread 01 — Index & Editorial', orientation: 'landscape' },
  { id: 3, src: magazineSpread2, caption: 'Spread 02 — Visual Essay', orientation: 'landscape' },
  { id: 4, src: magazineSpread3, caption: 'Spread 03 — Typography', orientation: 'landscape' },
  { id: 5, src: magazineBackcover, caption: 'Backcover', orientation: 'portrait' },
];

// Mobile-only: individual single pages (5032x7158, same portrait shape as
// cover/backcover) instead of the desktop two-page spreads — a landscape
// spread crammed into a narrow phone screen reads far worse than just
// showing one page at a time. Every item here is portrait, so they all
// share the same frame (see mobileFramePaddingTopPercent below) with no
// letterboxing worth mentioning between them.
const rawMobileSpreads = [
  { id: 1, src: magazineCover, caption: 'Cover', orientation: 'portrait' },
  { id: 2, src: magazinePage1, caption: 'Page 1', orientation: 'portrait' },
  { id: 3, src: magazinePage2, caption: 'Page 2', orientation: 'portrait' },
  { id: 4, src: magazinePage3, caption: 'Page 3', orientation: 'portrait' },
  { id: 5, src: magazinePage4, caption: 'Page 4', orientation: 'portrait' },
  { id: 6, src: magazinePage5, caption: 'Page 5', orientation: 'portrait' },
  { id: 7, src: magazinePage6, caption: 'Page 6', orientation: 'portrait' },
  { id: 8, src: magazineBackcover, caption: 'Backcover', orientation: 'portrait' },
];

// Two-stage load, same pattern as FinalWork's showcase image: a solid,
// genuinely sharp "stage 1" image loads first, then the full responsive
// (up to near-native resolution) "stage 2" srcset loads in behind it once
// stage 1 finishes — sequential, not parallel. Widths are capped per
// orientation near that image's own native resolution (no point requesting
// beyond it). The sequencing itself happens client-side in
// MagazineViewer.jsx since each spread needs its own fresh two-stage load
// on every navigation, not just once on page load.
// These specific sources compress far worse than a typical photo (dense,
// grainy scanned pages) — measured directly: portrait hits ~4.3MB by
// width 3200, landscape ~3.6MB by width 4800, roughly quadratic growth.
// Ceilings below are picked from real measurements, not native resolution,
// to keep the largest tier in the low single-digit MB.
const STAGE1_WIDTH = { portrait: 1600, landscape: 2000 };
const FULL_WIDTHS = {
  portrait: [800, 1200, 1600, 2000, 2400],
  landscape: [1200, 1600, 2000, 2600, 3200, 4000],
};

async function buildSpreads(rawItems) {
  return Promise.all(
    rawItems.map(async ({ id, src, caption, orientation }) => {
      const stage1 = await getImage({ src, width: STAGE1_WIDTH[orientation], format: 'webp' });
      const fullVariants = await Promise.all(
        FULL_WIDTHS[orientation].map((width) => getImage({ src, width, format: 'webp' }))
      );
      const fullSrcSet = fullVariants.map((v) => `${v.src} ${v.attributes.width}w`).join(', ');
      return {
        id,
        caption,
        orientation,
        stage1Src: stage1.src,
        stage1Width: stage1.attributes.width,
        stage1Height: stage1.attributes.height,
        fullSrcSet,
      };
    })
  );
}

const spreads = await buildSpreads(rawSpreads);
const mobileSpreads = await buildSpreads(rawMobileSpreads);

// Every page shares this one frame ratio (the landscape spreads' native
// 10063x7158) so the viewer never changes height when you navigate between
// the portrait cover/backcover and the wider spreads — cover/backcover
// render centered and letterboxed inside the same-height frame instead of
// using their own (much taller) aspect ratio. Expressed as a padding-top
// percentage (the classic aspect-ratio hack) rather than the `aspect-ratio`
// property — see the comment on .spread-frame for why.
const frameAspectRatio = 10063 / 7158;
const framePaddingTopPercent = (1 / frameAspectRatio) * 100;

// Mobile frame ratio is the cover's own native ratio (5103x7158) instead —
// every mobile item is portrait and near-identical in shape (pages are
// 5032x7158, cover/backcover 5103x7158), so cover/backcover render at
// exactly full width with zero letterbox, and pages sit at ~98.6% of that
// width — visually indistinguishable from full width, without needing a
// separate per-item aspect ratio.
const mobileFrameAspectRatio = 5103 / 7158;
const mobileFramePaddingTopPercent = (1 / mobileFrameAspectRatio) * 100;
---

<section class={styles.screen}>
  <SplitLayout
    client:load
    title="Personal Magazine"
    description="Voor het vak Design 3 ontwierp ik een editorial magazine van acht pagina's dat functioneert als een visuele weerspiegeling van mijn identiteit en interesses. Als fundament bestudeerde ik de lay-outs, strakke grids en typografie van high-end modebladen zoals Vogue. Om dit klassieke stramien te doorbreken en er mijn eigen visuele handtekening aan te geven, heb ik de fotografie intensief bewerkt met experimentele Photoshop-technieken, waaronder duotone- en wave-effecten. Het resultaat is een dynamische publicatie waarin redactioneel ontwerp, complexe beeldbewerking en typografie samenkomen. Dit project illustreert hoe ik traditionele editorial conventies kan combineren met een persoonlijke, gedurfde esthetiek tot één kloppend visueel geheel."
    tools={["InDesign", "Photoshop", "Lightroom"]}
  >
    <div slot="leftContent" class={styles['content-wrapper']}>
      <!-- Desktop: two-page spreads. CSS shows/hides based on viewport —
           client:media below also skips hydrating the mobile viewer's JS
           entirely until that media query actually matches. -->
      <div class={styles['desktop-viewer']}>
        <MagazineViewer client:load spreads={spreads} framePaddingTopPercent={framePaddingTopPercent} />
      </div>
      <div class={styles['mobile-viewer']}>
        <MagazineViewer client:media="(max-width: 768px)" spreads={mobileSpreads} framePaddingTopPercent={mobileFramePaddingTopPercent} initialIndex={0} />
      </div>
    </div>
  </SplitLayout>
</section>
