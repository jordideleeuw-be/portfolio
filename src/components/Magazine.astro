---
import { getImage } from 'astro:assets';
import MagazineViewer from './MagazineViewer.jsx';
import SplitLayout from './SplitLayout.jsx';

import magazineCover from '../assets/images/magazine-cover.png';
import magazineSpread1 from '../assets/images/magazine-spread1.png';
import magazineSpread2 from '../assets/images/magazine-spread2.png';
import magazineSpread3 from '../assets/images/magazine-spread3.png';
import magazineBackcover from '../assets/images/magazine-backcover.png';

// Native resolution: cover/backcover (portrait) are 5103x7158; the three
// spreads (landscape) are 10063x7158. Orientation is known statically per
// file, so it doesn't need to be derived from a fetched variant.
const rawSpreads = [
  { id: 1, src: magazineCover, caption: 'Cover', orientation: 'portrait' },
  { id: 2, src: magazineSpread1, caption: 'Spread 01 — Index & Editorial', orientation: 'landscape' },
  { id: 3, src: magazineSpread2, caption: 'Spread 02 — Visual Essay', orientation: 'landscape' },
  { id: 4, src: magazineSpread3, caption: 'Spread 03 — Typography', orientation: 'landscape' },
  { id: 5, src: magazineBackcover, caption: 'Backcover', orientation: 'portrait' },
];

// Two-stage load, same pattern as FinalWork's showcase image: a solid,
// genuinely sharp "stage 1" image loads first, then the full responsive
// (up to near-native resolution) "stage 2" srcset loads in behind it once
// stage 1 finishes — sequential, not parallel. Widths are capped per
// orientation near that image's own native resolution (no point requesting
// beyond it). The sequencing itself happens client-side in
// MagazineViewer.jsx since each spread needs its own fresh two-stage load
// on every navigation, not just once on page load.
// These specific sources compress far worse than a typical photo (dense,
// grainy scanned pages) — measured directly: portrait hits ~4.3MB by
// width 3200, landscape ~3.6MB by width 4800, roughly quadratic growth.
// Ceilings below are picked from real measurements, not native resolution,
// to keep the largest tier in the low single-digit MB.
const STAGE1_WIDTH = { portrait: 1600, landscape: 2000 };
const FULL_WIDTHS = {
  portrait: [800, 1200, 1600, 2000, 2400],
  landscape: [1200, 1600, 2000, 2600, 3200, 4000],
};

const spreads = await Promise.all(
  rawSpreads.map(async ({ id, src, caption, orientation }) => {
    const stage1 = await getImage({ src, width: STAGE1_WIDTH[orientation], format: 'webp' });
    const fullVariants = await Promise.all(
      FULL_WIDTHS[orientation].map((width) => getImage({ src, width, format: 'webp' }))
    );
    const fullSrcSet = fullVariants.map((v) => `${v.src} ${v.attributes.width}w`).join(', ');
    return {
      id,
      caption,
      orientation,
      stage1Src: stage1.src,
      stage1Width: stage1.attributes.width,
      stage1Height: stage1.attributes.height,
      fullSrcSet,
    };
  })
);

// Every page shares this one frame ratio (the landscape spreads' native
// 10063x7158) so the viewer never changes height when you navigate between
// the portrait cover/backcover and the wider spreads — cover/backcover
// render centered and letterboxed inside the same-height frame instead of
// using their own (much taller) aspect ratio. Expressed as a padding-top
// percentage (the classic aspect-ratio hack) rather than the `aspect-ratio`
// property — see the comment on .spread-frame for why.
const frameAspectRatio = 10063 / 7158;
const framePaddingTopPercent = (1 / frameAspectRatio) * 100;
---

<section class="screen magazine">
  <SplitLayout
    client:load
    title="JIDLI — Editorial Magazine"
    description="A printed companion piece for the JIDLI hybrid album — an editorial magazine spread covering the visual essay, typography direction, and behind-the-scenes process."
    tools={["InDesign", "Photoshop", "Lightroom"]}
  >
    <div slot="leftContent" class="content-wrapper">
      <!-- De Viewer laadt hier live in -->
      <MagazineViewer client:load spreads={spreads} framePaddingTopPercent={framePaddingTopPercent} />
    </div>
  </SplitLayout>
</section>

<style is:global>
  /* GLOBAL STYLES VOOR DE REACT VIEWER (Omdat het in React zit, werkt is:global hier het best) */
  .magazine-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* Ratio comes from an inline padding-top percentage (paddingTopPercent,
     matched to the landscape spreads) instead of the `aspect-ratio`
     property — the classic padding-hack technique, since `aspect-ratio`
     doesn't reliably recompute in every browser when this box's width
     changes via the info-panel's CSS Grid transition. Every page — portrait
     or landscape — sizes to the exact same frame height at a given column
     width; landscape spreads fill it edge-to-edge, portrait cover/backcover
     render centered and letterboxed inside it via object-fit on the image. */
  .spread-frame {
    width: 100%;
    height: 0;
    position: relative;
    background-color: #ffffff;
  }

  /* Cover/backcover stay off white on purpose — fully transparent so the
     screen's own background shows through with no grey tint, letterboxed
     around them instead of the white used for the spreads (which fill the
     frame edge-to-edge anyway). */
  .spread-frame--portrait {
    background-color: transparent;
  }

  .spread-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain; /* CRUCIAAL: Zorgt dat je foto ALTIJD in zijn originele verhouding past! */
    display: block;
    /* filter (not box-shadow) so the shadow hugs the visible, letterboxed
       image content instead of the full (invisible) frame rectangle. */
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.15));
  }

  /* Two-stage load: stage 1 (the base .spread-image) renders immediately
     and stays visible; stage 2 (this) sits on top at the same position and
     only fades in once its own full-res srcset has actually loaded. */
  .spread-image--full {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .spread-image--full.loaded {
    opacity: 1;
  }

  /* Knoppen styling */
  .magazine-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 600px;
  }

  .nav-btn {
    background: none;
    border: none;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .nav-btn:hover:not(:disabled) {
    opacity: 0.6;
  }

  .nav-btn:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  .nav-arrow-icon {
    width: 2rem;
    height: auto;
    display: block;
    /* arrow.svg is baked white for use on SplitLayout's dark info panel —
       brightness(0) forces it black here without touching that file. */
    filter: brightness(0);
  }

  .nav-btn--prev .nav-arrow-icon {
    transform: rotate(180deg);
  }
</style>

<style>
  /* De basis sectie */
  .screen {
    width: 100%;
    min-height: 100vh;
    background-color: #fff; /* Je achtergrondkleur */
  }

  .content-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>